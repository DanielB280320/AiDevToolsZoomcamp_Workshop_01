# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Required in production ---------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Comma-separated. Required in production.
ALLOWED_HOSTS=chores.example.com

# --- Database ------------------------------------------------------------
# Omit for the SQLite default (db.sqlite3 in the project root).
# PostgreSQL needs no code change, only this line:
# DATABASE_URL=postgres://user:password@localhost:5432/chores
# CONN_MAX_AGE=60

# --- Household -----------------------------------------------------------
# IANA timezone name. Every due date and overdue check is evaluated here.
TIME_ZONE=UTC

# --- Production TLS ------------------------------------------------------
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# CSRF_TRUSTED_ORIGINS=https://chores.example.com
